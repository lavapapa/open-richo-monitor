{
  "name": "ricoh-monitor-desktop",
  "version": "0.1.4",
  "description": "RichoMonitor 桌面端",
  "type": "module",
  "scripts": {
    "build:notifications": "node ../../scripts/build-notification-runtime.mjs",
    "package:macos": "node ../../scripts/build-macos.mjs",
    "package:macos:dmg": "npm run package:macos && node ../../scripts/package-macos-dmg.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri"
  },
  "dependencies": {
    "@kitlangton/rolling-number": "^0.4.1",
    "@lucide/svelte": "^1.51.0",
    "@tanstack/svelte-virtual": "^3.13.39",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-notification": "2.4.0",
    "canvas-confetti": "^1.9.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/svelte": "^5.4.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^30.1.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.2"
  }
}
