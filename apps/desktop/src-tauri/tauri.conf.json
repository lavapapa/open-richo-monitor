{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RichoMonitor",
  "version": "0.1.4",
  "identifier": "dev.ricohmonitor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "RichoMonitor",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwMTVERDU4N0QwQTkxQjMKUldTemtRcDlXTjBWSUxGaTdVdkxQNU9jNjYxd21tZytOM1RwNExWVFVIS2dmVVpoeXdKdFZCS20K",
      "endpoints": [
        "https://gitee.com/marvinfore/open-richo-monitor/releases/download/latest/latest.json",
        "https://github.com/lavapapa/open-richo-monitor/releases/latest/download/latest.json"
      ]
    }
  }
}
